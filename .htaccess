<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Security Headers
  <IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-XSS-Protection "1; mode=block"
    Header set X-Frame-Options "SAMEORIGIN"
  </IfModule>

  # Allow static files in /uploads/
  RewriteRule ^uploads/(.*)$ server/uploads/$1 [L]

  # Allow direct access to existing files/folders
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Forward API requests to Node backend if running reverse proxy
  # RewriteRule ^api/(.*)$ http://127.0.0.1:5000/api/$1 [P,L]

  # Client-side SPA fallback to index.html
  RewriteRule ^ index.html [L]
</IfModule>
